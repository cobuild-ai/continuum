# ==============================================================================
# 🌐 Continuum Vibe Server - AI Engine & Runtime Environment Configuration
# ==============================================================================
# 모든 AI 모델 전환, 커스텀 API Gateway URL, API 키 및 런타임 설정은 본 .env 파일을 통해 제어됩니다.
# 코드를 수정할 필요 없이 아래 옵션을 주석/해제하여 즉시 적용할 수 있습니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 활성 AI 프로바이더 선택 (Active AI Provider)
# ------------------------------------------------------------------------------
# 지원 옵션: "gemini" | "claude" | "codex" | "openai" | "skybrain"
CONTINUUM_AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 2. Google Gemini 설정 (Default: Gemini 3.8 Flash)
# ------------------------------------------------------------------------------
CONTINUUM_GEMINI_MODEL=gemini-3.8-flash
# CONTINUUM_GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
# GEMINI_API_KEY="" # 비워둘 경우 ~/.zshrc 의 GEMINI_API_KEY 를 자동으로 로드합니다.

# ------------------------------------------------------------------------------
# 3. Anthropic Claude 설정 (향후 전환 시 사용)
# ------------------------------------------------------------------------------
# CONTINUUM_AI_PROVIDER=claude
CONTINUUM_CLAUDE_MODEL=claude-3-7-sonnet-20250219
# CONTINUUM_CLAUDE_API_URL="https://api.anthropic.com/v1/messages" # 사내 프록시나 Gateway 사용 시 오버라이드
# ANTHROPIC_API_KEY="sk-ant-..."

# ------------------------------------------------------------------------------
# 4. OpenAI / Codex / 사내 API 게이트웨이 설정 (향후 전환 시 사용)
# ------------------------------------------------------------------------------
# CONTINUUM_AI_PROVIDER=openai
CONTINUUM_OPENAI_MODEL=gpt-4o
# CONTINUUM_OPENAI_API_URL="https://api.openai.com/v1/chat/completions" # 표준 OpenAI 엔드포인트
# OPENAI_API_KEY="sk-..."

# ------------------------------------------------------------------------------
# 5. 커스텀 OpenAI 호환 프록시 / 로컬 서버 URL (LiteLLM, vLLM, Ollama, Cloudflare Gateway 등)
# ------------------------------------------------------------------------------
# 아래 URL을 지정하면 OpenAI / Codex 모드 사용 시 모든 호출이 해당 커스텀 게이트웨이로 라우팅됩니다.
# CONTINUUM_CUSTOM_API_URL="http://127.0.0.1:11434/v1/chat/completions" # Ollama
# CONTINUUM_CUSTOM_API_URL="http://10.0.0.1:8000/v1/chat/completions"  # LiteLLM Proxy / vLLM

# ------------------------------------------------------------------------------
# 6. 로컬 온디바이스 SLM: SkyBrain 설정 (완전 선택 사항 / Optional)
# ------------------------------------------------------------------------------
# SkyBrain 데몬이 없을 경우 false 로 두면 불필요한 대기 없이 클라우드 LLM 단독으로 즉시 동작합니다.
CONTINUUM_SKYBRAIN_ENABLED=false
CONTINUUM_SKYBRAIN_URL=http://127.0.0.1:8000/v1/chat/completions
CONTINUUM_SKYBRAIN_MODEL=qwen3.8

# ------------------------------------------------------------------------------
# 7. 서버 및 워크스페이스 기본값
# ------------------------------------------------------------------------------
CONTINUUM_HOST=0.0.0.0
CONTINUUM_PORT=8080
CONTINUUM_DEFAULT_WORKSPACE_ROOT=/Users/smilelife/Projects/OSSProject/01-production

# ------------------------------------------------------------------------------
# 8. 대화 내역 SQLite 보관 정책 (Retention Policy)
# ------------------------------------------------------------------------------
# 대화가 무한정 쌓이지 않도록 단기 작업 기억 유지 후 자동 정리합니다. (단위: 일, 기본값: 7일, 0 = 무제한)
CONTINUUM_CHAT_RETENTION_DAYS=7
