# ==============================================================================
# 🌐 Continuum Vibe Server - AI Engine & Runtime Environment Configuration
# ==============================================================================
# 모든 AI 모델 전환 및 런타임 설정은 본 .env 파일을 통해 제어됩니다.
# 코드를 수정할 필요 없이 아래 옵션을 주석/해제하여 즉시 적용할 수 있습니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 활성 AI 프로바이더 선택 (Active AI Provider)
# ------------------------------------------------------------------------------
# 지원 옵션: "gemini" | "claude" | "codex" | "openai" | "skybrain"
CONTINUUM_AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 2. Google Gemini 설정 (Default: Gemini 3.8 Flash)
# ------------------------------------------------------------------------------
CONTINUUM_GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY="" # 비워둘 경우 ~/.zshrc 의 GEMINI_API_KEY 를 자동으로 로드합니다.

# ------------------------------------------------------------------------------
# 3. Anthropic Claude 설정 (향후 전환 시 사용)
# ------------------------------------------------------------------------------
# CONTINUUM_AI_PROVIDER=claude
CONTINUUM_CLAUDE_MODEL=claude-3-7-sonnet-20250219
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# ------------------------------------------------------------------------------
# 4. OpenAI / Codex 설정 (향후 전환 시 사용)
# ------------------------------------------------------------------------------
# CONTINUUM_AI_PROVIDER=openai
CONTINUUM_OPENAI_MODEL=gpt-4o
# OPENAI_API_KEY="your-openai-api-key"

# ------------------------------------------------------------------------------
# 5. 로컬 온디바이스 SLM: SkyBrain 설정 (완전 선택 사항 / Optional)
# ------------------------------------------------------------------------------
# SkyBrain 데몬이 없을 경우 false 로 두면 불필요한 대기 없이 클라우드 LLM 단독으로 즉시 동작합니다.
CONTINUUM_SKYBRAIN_ENABLED=false
CONTINUUM_SKYBRAIN_URL=http://127.0.0.1:8000/v1/chat/completions
CONTINUUM_SKYBRAIN_MODEL=qwen3.8

# ------------------------------------------------------------------------------
# 6. 서버 및 워크스페이스 기본값
# ------------------------------------------------------------------------------
CONTINUUM_HOST=0.0.0.0
CONTINUUM_PORT=8080
CONTINUUM_DEFAULT_WORKSPACE_ROOT=/Users/smilelife/Projects/OSSProject/01-production
